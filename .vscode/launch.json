{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Anexar",
            "type": "cppdbg",
            "request": "attach",
            "program": "insira o nome do programa, por exemplo ${workspaceFolder}/a.out",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Habilitar a reformatação automática para gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Definir Tipo de Desmontagem como Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug auxiliar (Linux)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/output/auxiliar",
            "args": ["3", "2", "2", "4"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Build auxiliar",
            "setupCommands": [
                {
                    "description": "Habilita pretty-printing no GDB",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug paraleloThreads (Linux)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/output/paraleloThreads",
            "args": ["output/matrizes/matriz_m1.txt", "output/matrizes/matriz_m2.txt", "2"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Build paraleloThreads",
            "setupCommands": [
                {
                    "description": "Habilita pretty-printing no GDB",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}